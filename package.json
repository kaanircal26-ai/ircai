{
  "name": "tozra-mobile",
  "version": "1.5.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "description": "TOZRA Creative Intelligence — native iOS and Android app",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "node --check api/_auth.js && node --check api/config.js && node --check api/chat.js && node --check api/transcribe.js && node --check api/realtime-session.js && node --check api/generate-image.js && node --check tozra-web.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~54.0.0",
    "expo-audio": "~1.0.13",
    "expo-constants": "~18.0.10",
    "expo-file-system": "~19.0.17",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video-thumbnails": "~10.0.7",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "@expo/vector-icons": "^15.0.2"
  },
  "devDependencies": {
    "babel-preset-expo": "~54.0.0"
  }
}
